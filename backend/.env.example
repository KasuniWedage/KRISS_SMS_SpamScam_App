# MySQL configuration matching the SDS data-layer design.
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://kriss_user:kriss_password@127.0.0.1:3306/kriss_sms
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
MODEL_DIR=./model

# Browser CORS is disabled when blank. Production values must be explicit.
CORS_ORIGINS=
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Required for release Android builds; HTTPS only and must end with /.
ANDROID_API_BASE_URL=https://api.example.com/

# For quick local testing only, you can instead use:
# DATABASE_URL=sqlite:///./kriss_dev.db

# --- Forgot Password (email delivery) ---
# If left blank, reset links are logged to the server console instead of
# emailed, so the flow is still testable without real SMTP credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecureMessage <no-reply@securemessage.app>
PASSWORD_RESET_TOKEN_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
# Deep link your Android app registers to catch the reset-password link
FRONTEND_RESET_URL=securemessage://reset-password

# --- Google Sign-In ---
# Use the WEB client ID from Google Cloud Console (Credentials), not the
# Android client ID. Configure this same value as serverClientId on Android.
GOOGLE_OAUTH_CLIENT_ID=

# --- Facebook Login ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_TOKEN=

# --- Firebase Authentication (recommended for Forgot Password) ---
# Path to the service account JSON from Firebase Console -> Project
# Settings -> Service Accounts -> Generate new private key.
# When set, Forgot Password is handled entirely by Firebase on the Android
# side — no SMTP configuration above is needed for that flow.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
