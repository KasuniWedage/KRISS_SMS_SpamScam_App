<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_hero_flat"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="42dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">
        <ImageView android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/ripple_circle" android:contentDescription="@string/back" android:padding="8dp" android:src="@drawable/ic_arrow_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/batch_history" android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
        <ImageView android:id="@+id/clearAllButton" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/ripple_circle" android:contentDescription="@string/clear_all_batch_history" android:padding="8dp" android:src="@drawable/ic_delete_outline" xmlns:app="http://schemas.android.com/apk/res-auto" app:tint="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:gravity="center"
        android:text="@string/batch_history_empty"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="14dp" />
</LinearLayout>
