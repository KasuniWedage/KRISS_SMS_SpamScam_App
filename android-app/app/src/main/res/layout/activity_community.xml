<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_gradient_hero_flat" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="42dp" android:paddingEnd="20dp" android:paddingBottom="22dp">
        <ImageView android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/ripple_circle" android:contentDescription="@string/back" android:padding="8dp" android:src="@drawable/ic_arrow_back" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/community_feed" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <com.google.android.material.chip.ChipGroup android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.chip.Chip android:id="@+id/communityTab" style="@style/App.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/community_feed" />
        <com.google.android.material.chip.Chip android:id="@+id/reportsTab" style="@style/App.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/my_reports" />
        <com.google.android.material.chip.Chip android:id="@+id/feedbackTab" style="@style/App.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/my_feedback" />
    </com.google.android.material.chip.ChipGroup>
    <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="28dp" android:gravity="center" android:text="@string/community_empty" android:textColor="@color/text_secondary" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="12dp" />
</LinearLayout>
